# Dependencies
node_modules/
.pnpm-store/
dist/
dist-ssr/
build/
*.tsbuildinfo
.vite/
target/
src-tauri/target/

# Env / secrets
.env
.env.*
!.env.example
!.env.*.example
*.key
*.pem
*.p12
.credentials.json

# Local / personal (not versioned)
CLAUDE.local.md
AGENTS.local.md
SPEC.md
PENDENCIAS.md
.claude/settings.local.json
.claude/worktrees/
.grok/

# Models / large binaries (downloaded at runtime)
/models/
*.gguf
*.onnx
# keep Rust source modules named models/
!src-tauri/src/models/
!src-tauri/src/models/**

# App data / recordings (local only)
data/
recordings/
*.wav
*.mp3
*.m4a
*.webm

# IDE / OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Logs / coverage
*.log
logs/
coverage/
.nyc_output/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test artifacts
playwright-report/
test-results/
.playwright/

# Scratch work (never versioned)
scratch/
tmp/

# Tauri gen (local)
src-tauri/gen/schemas/*.json
!src-tauri/gen/schemas/.gitkeep

# Staged by build.rs from the sys crate; rebuilt on every cargo build.
src-tauri/gpu-backends/

# A meeting database is somebody's conversations. Copying one into the
# checkout to look at it is a normal thing to do while debugging, and
# committing it would publish every word of every meeting in it.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Signing material and credentials. Never versioned, whatever the extension.
*.pfx
*.jks
*.p12
.npmrc
.netrc
id_rsa
id_ed25519

# The Playwright MCP server writes here — accessibility snapshots of whatever
# was open in the browser, which is not this project's to publish.
.playwright-mcp/
