# Dependencies
node_modules/
.pnpm-store/
dist/
dist-ssr/
build/
*.tsbuildinfo
.vite/
target/
src-tauri/target/

# Env / secrets
.env
.env.*
!.env.example
!.env.*.example
*.key
*.pem

# Local / personal (not versioned)
CLAUDE.local.md
SPEC.md
PENDENCIAS.md
